# Folder the media pipeline writes web copies into, and that `npm run dev`
# and `npm run preview` serve as /media. Keep it outside the repo.
MEDIA_DIR=/absolute/path/to/portfolio-media

# Local JSON file mapping each video id to its master file (see
# scripts/media/sources.example.json). Keep it outside the repo.
MEDIA_SOURCES=/absolute/path/to/media-sources.json

# Vercel Blob read-write token, only needed for `npm run media:upload`.
BLOB_READ_WRITE_TOKEN=
