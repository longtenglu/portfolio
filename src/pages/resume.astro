---
// The printable resume. scripts/resume/build-pdf.mjs prints this page with
// headless Chrome to public/resume/Longteng-Lu-Resume.pdf.
import { education, experience, site } from "../content/copy";
import { resume } from "../content/resume";
import Base from "../layouts/Base.astro";

const contactLine = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: site.url.replace("https://", ""), href: site.url },
  { label: site.github.replace("https://", ""), href: site.github },
  { label: site.linkedin.replace("https://www.", ""), href: site.linkedin },
];
---

<Base title={resume.title} bodyClass="resume-page">
  <div class="toolbar">
    <a class="link" href="/">{resume.back}</a>
    <a class="btn" href={`/resume/${resume.pdfName}`} download>{resume.download}</a>
  </div>

  <main class="cv" id="main">
    <header class="cv__head">
      <h1 class="cv__name">{site.name}</h1>
      <p class="cv__headline">{resume.headline}</p>
      <ul class="cv__contact mono">
        <li>{resume.location}</li>
        {
          contactLine.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
            </li>
          ))
        }
      </ul>
    </header>

    <section class="cv__section" aria-labelledby="cv-summary">
      <h2 id="cv-summary" class="cv__h2 mono">{resume.summaryHeading}</h2>
      <p class="cv__summary">{resume.summary}</p>
    </section>

    <section class="cv__section" aria-labelledby="cv-experience">
      <h2 id="cv-experience" class="cv__h2 mono">{resume.experienceHeading}</h2>
      {
        experience.roles.map((role) => (
          <article class="cv__item">
            <div class="cv__row">
              <h3 class="cv__role">
                {role.role}, <span>{role.org}</span>
              </h3>
              <p class="cv__dates mono">{role.dates}</p>
            </div>
            <ul class="cv__points">
              {role.stats && <li>{resume.taStats}</li>}
              {role.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="cv__section" aria-labelledby="cv-projects">
      <h2 id="cv-projects" class="cv__h2 mono">{resume.projectsHeading}</h2>
      {
        resume.projects.map((project) => (
          <article class="cv__item">
            <div class="cv__row">
              <h3 class="cv__role">
                {project.title} <span class="cv__stack">| {project.stack}</span>
              </h3>
              <p class="cv__dates mono">{project.dates}</p>
            </div>
            <ul class="cv__points">
              {project.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="cv__section" aria-labelledby="cv-skills">
      <h2 id="cv-skills" class="cv__h2 mono">{resume.skillsHeading}</h2>
      <dl class="cv__skills">
        {
          resume.skills.map((s) => (
            <div>
              <dt>{s.title}</dt>
              <dd>{s.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv__section" aria-labelledby="cv-education">
      <h2 id="cv-education" class="cv__h2 mono">{resume.educationHeading}</h2>
      {
        education.items.map((item) => (
          <article class="cv__item cv__item--tight">
            <div class="cv__row">
              <h3 class="cv__role">
                {item.title}, <span>{item.org}</span>
              </h3>
              <p class="cv__dates mono">{item.dates}</p>
            </div>
            {item.note && <p class="cv__note">{item.note}</p>}
          </article>
        ))
      }
      <h3 class="cv__h3 mono">{resume.certificationsHeading}</h3>
      <p class="cv__note">{education.certifications}</p>
      <h3 class="cv__h3 mono">{resume.learningHeading}</h3>
      <p class="cv__note">{resume.learning}</p>
    </section>
  </main>
</Base>

<style>
  :global(.resume-page) {
    padding: 0 var(--gutter) 80px;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    max-width: 860px;
    margin: 0 auto;
    padding-block: 24px;
  }

  .cv {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 56px);
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
  }

  .cv__name {
    font-size: clamp(38px, 6vw, 56px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .cv__headline {
    margin-top: 10px;
    font-size: 18px;
    font-weight: 560;
    color: var(--accent);
  }

  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }

  .cv__contact a:hover {
    color: var(--accent);
  }

  .cv__section {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--line-strong);
  }

  .cv__h2 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cv__h3 {
    margin-top: 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cv__summary {
    margin-top: 10px;
    color: var(--text);
    line-height: 1.55;
  }

  .cv__item {
    margin-top: 14px;
  }

  .cv__item--tight {
    margin-top: 10px;
  }

  .cv__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .cv__role {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }

  .cv__role span {
    font-weight: 500;
    color: var(--muted);
  }

  .cv__dates {
    flex: none;
    font-size: 12px;
    color: var(--muted);
  }

  .cv__points {
    display: grid;
    gap: 4px;
    margin-top: 6px;
  }

  .cv__points li {
    position: relative;
    padding-left: 16px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  .cv__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: 1px;
    background: var(--accent);
  }

  .cv__skills {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
  }

  .cv__skills div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 12px;
  }

  .cv__skills dt {
    font-weight: 700;
    font-size: 15px;
  }

  .cv__skills dd {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.5;
  }

  .cv__note {
    margin-top: 4px;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .cv__row {
      flex-direction: column;
      gap: 2px;
    }

    .cv__skills div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  /* Print: light paper, the same type and amber rules. One A4 page. The page
     margin is zero and the body carries the margin instead, so no part of
     the sheet shows the dark screen background. */
  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    :global(html),
    :global(body) {
      background: #fff !important;
      color: #141414 !important;
      color-scheme: light;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    :global(.resume-page) {
      padding: 12mm 14mm;
    }

    .toolbar {
      display: none;
    }

    .cv {
      max-width: none;
      padding: 0;
      border: 0;
      background: none;
      color: #141414;
    }

    .cv__name {
      font-size: 30px;
    }

    .cv__headline {
      margin-top: 4px;
      font-size: 13px;
      color: #8a5200;
    }

    .cv__contact {
      margin-top: 8px;
      font-size: 9px;
      color: #4a4a4a;
    }

    .cv__section {
      margin-top: 11px;
      padding-top: 7px;
      border-top: 1.5px solid #ffb000;
      break-inside: auto;
    }

    .cv__h2 {
      font-size: 8.5px;
      color: #8a5200;
    }

    .cv__h3 {
      margin-top: 7px;
      font-size: 8px;
      color: #4a4a4a;
    }

    .cv__summary,
    .cv__points li,
    .cv__skills dt,
    .cv__skills dd,
    .cv__note {
      font-size: 9.6px;
      line-height: 1.42;
      color: #2a2a2a;
    }

    .cv__item {
      margin-top: 6px;
      break-inside: avoid;
    }

    .cv__item--tight {
      margin-top: 4px;
    }

    .cv__role {
      font-size: 10.5px;
      color: #141414;
    }

    .cv__role span {
      color: #4a4a4a;
    }

    .cv__dates {
      font-size: 8.5px;
      color: #4a4a4a;
    }

    .cv__points {
      gap: 1px;
      margin-top: 2px;
    }

    .cv__points li {
      padding-left: 11px;
    }

    .cv__points li::before {
      width: 5px;
      background: #c98500;
    }

    .cv__skills {
      gap: 3px;
      margin-top: 4px;
    }

    .cv__skills div {
      grid-template-columns: 105px minmax(0, 1fr);
      gap: 8px;
    }

    .cv__skills dt {
      color: #141414;
    }

    .cv a {
      color: inherit;
    }
  }
</style>
