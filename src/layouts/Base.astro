---
import archivoUrl from "@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url";
import monoUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { site } from "../content/copy";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const { title = site.title, description = site.description, bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();

// Only the Latin subsets are loaded; every word on the site is Latin.
const latin =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const fontFaces = `
@font-face {
  font-family: "Archivo Variable";
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  font-stretch: 62% 125%;
  src: url(${archivoUrl}) format("woff2-variations"), url(${archivoUrl}) format("woff2");
  unicode-range: ${latin};
}
@font-face {
  font-family: "JetBrains Mono Variable";
  font-style: normal;
  font-display: swap;
  font-weight: 100 800;
  src: url(${monoUrl}) format("woff2-variations"), url(${monoUrl}) format("woff2");
  unicode-range: ${latin};
}`;
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Shared by link only for now: keep it out of search engines. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
