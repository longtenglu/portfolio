---
import { contact, footer, site } from "../content/copy";
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 class="label" id="contact-title"><span class="label__num">08</span>{contact.heading}</h2>
    <div class="contact__top">
      <p class="contact__title" data-reveal>{contact.title}</p>
      <aside class="clock" data-reveal style="--reveal-delay: 0.1s" aria-label={contact.clockLabel}>
        <p class="clock__label mono">{contact.clockLabel}</p>
        <p class="clock__time"><time data-clock>{contact.clockZone}</time></p>
        <p class="clock__zone mono">{contact.clockZone}</p>
      </aside>
    </div>
    <p class="contact__lead" data-reveal style="--reveal-delay: 0.06s">{contact.lead}</p>
    <div class="contact__email" data-reveal style="--reveal-delay: 0.1s">
      <a class="contact__address" href={`mailto:${site.email}`}>{site.email}</a>
      <button
        class="btn btn--ghost contact__copy"
        type="button"
        data-copy={site.email}
        data-copied={contact.copied}
        data-copied-status={contact.copiedStatus}
      >
        <span data-copy-label>{contact.copy}</span>
      </button>
      <span class="visually-hidden" aria-live="polite" data-copy-status></span>
    </div>
    <ul class="contact__links" data-reveal style="--reveal-delay: 0.14s">
      {
        contact.links.map((link) => (
          <li>
            <a class="btn btn--ghost" href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span class="visually-hidden">(opens in a new tab)</span>
              <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
                <path d="M3 11 11 3M5 3h6v6" stroke="currentColor" fill="none" stroke-width="1.4" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<footer class="footer">
  <div class="container footer__inner mono">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="footer__credit">{footer.credit}</p>
    <p class="footer__hint">
      <span class="footer__key">
        {footer.terminalHint.before} <kbd>{footer.terminalHint.key}</kbd> {footer.terminalHint.after}
      </span>
      <button class="footer__terminal" type="button" data-terminal-open>{footer.terminalButton}</button>
    </p>
  </div>
</footer>

<style>
  .contact {
    padding-bottom: clamp(72px, 9vw, 120px);
  }

  .contact__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-top: 40px;
  }

  .clock {
    flex: none;
    min-width: 240px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .clock__label,
  .clock__zone {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .clock__time {
    margin-block: 8px 6px;
    font-size: 56px;
    font-weight: 750;
    font-stretch: 90%;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .clock__time time:not(.is-live) {
    font-size: 24px;
  }

  .contact__title {
    font-size: clamp(44px, 8.4vw, 132px);
    font-weight: 820;
    font-stretch: 80%;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    max-width: 12ch;
    text-wrap: balance;
  }

  .contact__lead {
    margin-top: 28px;
    color: var(--muted);
    font-size: 18px;
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 20px;
  }

  .contact__address {
    font-size: clamp(24px, 3.6vw, 48px);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--accent);
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) left bottom / 0% 2px no-repeat;
    transition: background-size 0.5s var(--ease);
  }

  .contact__address:hover {
    background-size: 100% 2px;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .footer {
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 28px;
    font-size: 12px;
    color: var(--dim);
  }

  .footer__hint {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer__terminal {
    min-height: 32px;
    padding-inline: 10px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .footer__terminal:hover {
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .footer__key kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    margin-inline: 2px;
    padding-inline: 5px;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }

  @media (hover: none) {
    .footer__key {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .contact__top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
