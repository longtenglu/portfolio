---
import { contact, footer, site } from "../content/copy";
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 class="section-name" id="contact-title">{contact.heading}</h2>
    <p class="contact__title">{contact.title}</p>
    <p class="contact__lead">{contact.lead}</p>
    <div class="contact__email">
      <a class="contact__address" href={`mailto:${site.email}`}>{site.email}</a>
      <button
        class="btn btn--ghost contact__copy"
        type="button"
        data-copy={site.email}
        data-copied={contact.copied}
        data-copied-status={contact.copiedStatus}
      >
        <span data-copy-label>{contact.copy}</span>
      </button>
      <span class="visually-hidden" aria-live="polite" data-copy-status></span>
    </div>
    <p class="contact__availability">
      {contact.availability.map((line) => <span>{line}</span>)}
    </p>
    <ul class="contact__links">
      {
        contact.links.map((link) => (
          <li>
            <a class="link" href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span class="visually-hidden">(opens in a new tab)</span>
              <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
                <path d="M3 11 11 3M5 3h6v6" stroke="currentColor" fill="none" stroke-width="1.4" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<footer class="footer">
  <div class="container footer__inner">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="footer__credit">{footer.credit}</p>
  </div>
</footer>

<style>
  .contact {
    padding-bottom: clamp(72px, 9vw, 120px);
  }

  .contact__title {
    margin-top: 28px;
    max-width: 22ch;
    font-size: clamp(32px, 4.6vw, 58px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .contact__lead {
    margin-top: 24px;
    color: var(--muted);
    font-size: 18px;
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 16px;
  }

  .contact__address {
    font-size: clamp(24px, 3.6vw, 48px);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--accent);
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) left bottom / 0% 2px no-repeat;
    transition: background-size 0.5s var(--ease);
  }

  .contact__address:hover {
    background-size: 100% 2px;
  }

  .contact__availability {
    margin-top: 18px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text);
  }

  .contact__availability span {
    display: block;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 32px;
  }

  .footer {
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 28px;
    font-size: 13px;
    color: var(--dim);
  }
</style>
