---
// One film in a series, as a row of a playlist: a small poster (with the same
// muted hover preview as a full card), the film's name, and its running time.
import { videos } from "../content/copy";
import { formatDuration, isoDuration, type getVideo } from "../lib/media";

interface Props {
  id: string;
  /** Full name, for the modal and the button's label. */
  title: string;
  /** Short name shown in the row. */
  label: string;
  media: ReturnType<typeof getVideo>;
}

const { id, title, label, media } = Astro.props;
const aria = `${videos.play} ${title}, ${formatDuration(media.duration)}, with sound`;
---

<button class="vrow" type="button" data-video-open={id} data-preview-host aria-label={aria}>
  <span class="vrow__frame">
    <img src={media.poster} alt="" width={720} height={1280} loading="lazy" decoding="async" />
    <video class="vcard__preview" muted loop playsinline preload="none" data-src={media.preview} aria-hidden="true" tabindex="-1"></video>
  </span>
  <span class="vrow__text" aria-hidden="true">
    <span class="vrow__title">{label}</span>
    <span class="vrow__meta mono">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
      <time datetime={isoDuration(media.duration)}>{formatDuration(media.duration)}</time>
    </span>
  </span>
</button>

<style>
  .vrow {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    padding: 0 16px 0 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: 0 0 0 1px var(--line);
    text-align: left;
    transition: box-shadow 0.3s;
  }

  .vrow:hover,
  .vrow:focus-visible {
    box-shadow: 0 0 0 1px var(--accent), 0 12px 40px rgba(255, 176, 0, 0.12);
  }

  .vrow__frame {
    position: relative;
    flex: none;
    height: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #000;
  }

  .vrow__frame img,
  .vrow__frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), opacity 0.4s;
  }

  .vrow__frame video {
    opacity: 0;
  }

  .vrow.is-previewing .vrow__frame video {
    opacity: 1;
  }

  .vrow:hover .vrow__frame img,
  .vrow:hover .vrow__frame video {
    transform: scale(1.03);
  }

  .vrow__text {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .vrow__title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .vrow__meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    transition: color 0.2s;
  }

  .vrow__meta svg {
    width: 14px;
    height: 14px;
  }

  .vrow:hover .vrow__meta,
  .vrow:focus-visible .vrow__meta {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .vrow {
      height: auto;
    }

    .vrow__frame {
      width: 88px;
      height: auto;
    }
  }
</style>
