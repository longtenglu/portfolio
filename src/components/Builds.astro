---
import { builds } from "../content/copy";
import SectionLabel from "./SectionLabel.astro";
---

<section class="section builds" id="builds" aria-labelledby="builds-title">
  <div class="container">
    <div class="builds__head">
      <SectionLabel id="builds-title" heading={builds.heading} />
      <p class="builds__intro">{builds.intro}</p>
    </div>
    <ul class="builds__grid">
      {
        builds.items.map((item, i) => (
          <li class="build" data-reveal style={`--reveal-delay: ${(i % 2) * 0.08}s`}>
            <div class="build__top">
              <span class="build__num mono">0{i + 1}</span>
              <span class="build__kicker mono">{item.kicker}</span>
            </div>
            <h3 class="build__title">{item.title}</h3>
            <p class="build__text">{item.text}</p>
            <ul class="build__examples">
              {item.examples.map((example) => (
                <li>
                  <span class="build__prompt mono" aria-hidden="true">
                    {">"}
                  </span>
                  {example}
                </li>
              ))}
            </ul>
            {item.link && (
              <a class="link build__link" href={item.link.href} target="_blank" rel="noopener noreferrer">
                {item.link.label}
                <span class="visually-hidden">(opens in a new tab)</span>
                <svg viewBox="0 0 14 14" aria-hidden="true">
                  <path d="M3 11 11 3M5 3h6v6" stroke="currentColor" fill="none" stroke-width="1.3" />
                </svg>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .builds__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: end;
  }

  .builds__intro {
    color: var(--muted);
    max-width: 50ch;
    justify-self: end;
  }

  .builds__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 48px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .build {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3.2vw, 44px);
    background: var(--bg);
    transition: background 0.3s;
  }

  .build:hover {
    background: var(--bg-raised);
  }

  .build__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .build__num {
    color: var(--accent);
  }

  .build__kicker {
    color: var(--muted);
  }

  .build__title {
    margin-top: 28px;
    font-size: clamp(26px, 2.8vw, 40px);
    font-weight: 800;
    font-stretch: 84%;
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .build__text {
    margin-top: 16px;
    color: var(--muted);
    max-width: 56ch;
    text-wrap: pretty;
  }

  .build__examples {
    display: grid;
    gap: 10px;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px dashed var(--line-strong);
    font-size: 15px;
    color: var(--text);
  }

  .build__examples li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    line-height: 1.5;
  }

  .build__prompt {
    color: var(--accent);
  }

  .build__link {
    margin-top: auto;
    padding-top: 28px;
    align-self: flex-start;
    background-position: left bottom;
  }

  @media (max-width: 820px) {
    .builds__head,
    .builds__grid {
      grid-template-columns: 1fr;
    }

    .builds__intro {
      justify-self: start;
    }
  }
</style>
