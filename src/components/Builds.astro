---
import { builds } from "../content/copy";
import { getImage } from "../lib/media";
import { validateBuildShot } from "../../scripts/lib/builds.mjs";

const items = builds.items.map((item) => {
  validateBuildShot(item);
  return { ...item, shot: item.shot ? getImage(item.shot) : null };
});
---

<section class="section builds" id="builds" aria-labelledby="builds-title">
  <div class="container">
    <h2 class="section-name" id="builds-title">{builds.heading}</h2>
    <p class="builds__intro">{builds.intro}</p>

    <ul class="builds__list">
      {
        items.map((item) => (
          <li class="build">
            <h3 class="build__title">{item.title}</h3>
            <div class="build__body">
              <p class="build__text">{item.text}</p>
              {item.link && (
                <a class="link" href={item.link.href} target="_blank" rel="noopener noreferrer">
                  {item.link.label}
                  <span class="visually-hidden">(opens in a new tab)</span>
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M3 11 11 3M5 3h6v6" stroke="currentColor" fill="none" stroke-width="1.3" />
                  </svg>
                </a>
              )}
              {item.shot && (
                <img
                  class="build__shot"
                  src={item.shot.src}
                  width={item.shot.width}
                  height={item.shot.height}
                  alt={item.shotAlt ?? ""}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <p class="builds__learning">{builds.learning}</p>
  </div>
</section>

<style>
  .builds__intro {
    margin-top: 18px;
    max-width: 60ch;
    color: var(--muted);
  }

  .builds__list {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }

  .build {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 64px);
    padding-block: clamp(28px, 3.4vw, 44px);
    border-bottom: 1px solid var(--line);
  }

  .build__title {
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .build__body {
    max-width: 54ch;
  }

  .build__text {
    color: var(--muted);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .build__body .link {
    margin-top: 16px;
  }

  .build__shot {
    display: block;
    width: 100%;
    max-width: 480px;
    height: auto;
    margin-top: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .builds__learning {
    margin-top: 22px;
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .build {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
