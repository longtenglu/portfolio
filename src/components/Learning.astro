---
import { learning } from "../content/copy";
import SectionLabel from "./SectionLabel.astro";
---

<section class="section learning" id="learning" aria-labelledby="learning-title">
  <div class="container learning__grid">
    <div>
      <SectionLabel id="learning-title" heading={learning.heading} />
      <p class="learning__intro">{learning.intro}</p>
      <a class="link learning__link" href={learning.link.href} target="_blank" rel="noopener noreferrer">
        {learning.link.label}
        <span class="visually-hidden">(opens in a new tab)</span>
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" stroke="currentColor" fill="none" stroke-width="1.3"></path></svg>
      </a>
    </div>
    <div class="log" data-reveal>
      <div class="log__bar mono" aria-hidden="true">
        <span></span><span></span><span></span>
        <em>~/learning.log</em>
      </div>
      <ol class="log__list mono">
        {
          learning.items.map((item) => (
            <li class:list={["log__item", `log__item--${item.status}`]}>
              <span class="log__status">{item.status === "done" ? "[x]" : "[ ]"}</span>
              <span class="log__title">{item.title}</span>
              <span class="log__tag">{item.status === "done" ? learning.done : learning.now}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .learning__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .learning__intro {
    margin-top: 28px;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 22ch;
  }

  .learning__link {
    margin-top: 28px;
  }

  .log {
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-raised);
    overflow: hidden;
  }

  .log__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
  }

  .log__bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
  }

  .log__bar em {
    margin-left: 10px;
    font-style: normal;
    color: var(--dim);
  }

  .log__list {
    padding: 14px 0;
    font-size: 14px;
  }

  .log__item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding: 10px 20px;
  }

  .log__status {
    color: var(--accent);
  }

  .log__title {
    color: var(--text);
  }

  .log__tag {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .log__item--now .log__status {
    color: var(--muted);
  }

  .log__item--now .log__tag {
    color: var(--on-accent);
    background: var(--accent);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .log__item--now .log__title::after {
    content: "_";
    margin-left: 4px;
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 820px) {
    .learning__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .log__item {
      grid-template-columns: 32px minmax(0, 1fr);
      padding-inline: 16px;
    }

    .log__tag {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
