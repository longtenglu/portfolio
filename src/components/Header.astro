---
import { nav, site } from "../content/copy";
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="brand" href="#top">
      <span class="brand__mark" aria-hidden="true">{"{L}"}</span>
      <span class="brand__name">{site.name}<span class="visually-hidden">, back to top</span></span>
    </a>
    <nav class="header__nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a class="header__resume" href="/resume">Resume</a></li>
      </ul>
    </nav>
    <button class="menu-button" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
      <span>Menu</span>
      <span class="menu-button__lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<dialog class="menu" id="menu" aria-label="Menu" data-menu>
  <div class="menu__top">
    <span class="brand__mark" aria-hidden="true">{"{L}"}</span>
    <button class="menu__close" type="button" data-menu-close>Close</button>
  </div>
  <nav class="menu__nav" aria-label="Menu">
    <ol class="menu__list">
      {
        nav.map((item, i) => (
          <li>
            <a href={item.href} data-menu-link>
              <span class="menu__num">0{i + 1}</span>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/resume">
          <span class="menu__num">0{nav.length + 1}</span>Resume
        </a>
      </li>
    </ol>
  </nav>
  <p class="menu__foot mono">{site.email}</p>
</dialog>

<style>
  /* Solid at every scroll position, so nothing shows behind the logo and
     links. The rule underneath appears once the page moves. */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }

  .header.is-scrolled {
    border-bottom-color: var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: calc(var(--max) + var(--gutter) * 2);
    margin-inline: auto;
    padding: 18px var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .brand__mark {
    display: inline-grid;
    place-items: center;
    height: 30px;
    padding-inline: 6px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .header__nav ul {
    display: flex;
    gap: 6px;
  }

  .header__nav a {
    display: inline-block;
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    border-radius: 999px;
    transition: color 0.2s, background 0.2s;
  }

  .header__nav a:hover {
    color: var(--text);
    background: var(--bg-hover);
  }

  .header__nav .header__resume {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    margin-left: 6px;
  }

  .header__nav .header__resume:hover {
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
    background: transparent;
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding-inline: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .menu-button__lines {
    display: grid;
    gap: 6px;
    width: 26px;
  }

  .menu-button__lines i {
    display: block;
    height: 1.5px;
    background: currentColor;
  }

  @media (max-width: 820px) {
    .header__nav {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 18px var(--gutter) 32px;
    border: 0;
    background: var(--bg);
    flex-direction: column;
  }

  .menu[open] {
    display: flex;
  }

  .menu::backdrop {
    background: var(--bg);
  }

  .menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .menu__close {
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .menu__nav {
    margin-top: auto;
  }

  .menu__list {
    display: grid;
    gap: 4px;
  }

  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 6px;
    font-size: clamp(40px, 12vw, 64px);
    font-weight: 750;
    font-stretch: 80%;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .menu__num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .menu__foot {
    margin-top: 40px;
    font-size: 13px;
    color: var(--muted);
  }
</style>
