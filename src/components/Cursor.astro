<div class="cursor" aria-hidden="true" data-cursor></div>

<style>
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 9998;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
    opacity: 0;
    transition: width 0.25s var(--ease), height 0.25s var(--ease), margin 0.25s var(--ease), opacity 0.2s;
  }

  .cursor.is-visible {
    opacity: 1;
  }

  .cursor.is-hover {
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
  }

  @media (hover: none), (pointer: coarse) {
    .cursor {
      display: none;
    }
  }
</style>
