---
import { education, experience } from "../content/copy";
import SectionLabel from "./SectionLabel.astro";
---

<section class="section exp" id="experience" aria-labelledby="exp-title">
  <div class="container">
    <SectionLabel id="exp-title" heading={experience.heading} />
    <p class="exp__intro">{experience.intro}</p>

    <ol class="exp__list">
      {
        experience.roles.map((role) => (
          <li class="exp__item" data-reveal>
            <p class="exp__dates mono">{role.dates}</p>
            <div class="exp__body">
              <h3 class="exp__role">{role.role}</h3>
              {role.org && <p class="exp__org">{role.org}</p>}
              {role.stats && (
                <ul class="exp__stats">
                  {role.stats.map((stat) => (
                    <li class={stat.prefix ? "stat" : "stat stat--exact"}>
                      <span class="stat__prefix mono">{stat.prefix}</span>
                      <span class="stat__value">{stat.value}</span>
                      <span class="stat__label">{stat.label}</span>
                    </li>
                  ))}
                </ul>
              )}
              <ul class="exp__points">
                {role.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="edu" data-reveal>
      <h3 class="edu__title mono">{education.heading}</h3>
      <ul class="edu__list">
        {
          education.items.map((item) => (
            <li class="edu__item">
              <p class="exp__dates mono">{item.dates}</p>
              <div>
                <p class="edu__name">{item.title}</p>
                <p class="exp__org">{item.org}</p>
                {item.note && <p class="edu__note">{item.note}</p>}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="edu__certs">{education.certifications}</p>
    </div>
  </div>
</section>

<style>
  .exp__intro {
    margin-top: 20px;
    color: var(--muted);
  }

  .exp__list {
    margin-top: 48px;
    border-top: 1px solid var(--line);
  }

  .exp__item,
  .edu__item {
    display: grid;
    grid-template-columns: minmax(150px, 0.32fr) minmax(0, 1fr);
    gap: 24px;
    padding-block: clamp(28px, 3.6vw, 48px);
    border-bottom: 1px solid var(--line);
  }

  .exp__dates {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 6px;
  }

  .exp__role {
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .exp__org {
    margin-top: 4px;
    color: var(--accent);
    font-weight: 500;
  }

  .exp__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 28px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .stat {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 22px 22px 24px;
    background: var(--bg);
  }

  .stat__prefix {
    min-height: calc(13px * 1.6);
    font-size: 13px;
    color: var(--muted);
  }

  .stat__value {
    font-size: clamp(44px, 5vw, 72px);
    font-weight: 800;
    font-stretch: 90%;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .stat__label {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }

  .exp__points {
    display: grid;
    gap: 10px;
    margin-top: 24px;
    max-width: 68ch;
  }

  .exp__points li {
    position: relative;
    padding-left: 22px;
    color: var(--muted);
  }

  .exp__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(0.8em - 1px);
    width: 10px;
    height: 2px;
    background: var(--accent);
    opacity: 0.85;
  }

  .edu {
    margin-top: 72px;
  }

  .edu__title {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }

  .edu__list {
    margin-top: 20px;
    border-top: 1px solid var(--line);
  }

  .edu__item {
    padding-block: 24px;
  }

  .edu__name {
    font-size: 19px;
    font-weight: 650;
    line-height: 1.3;
  }

  .edu__note {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
  }

  .edu__certs {
    margin-top: 24px;
    max-width: 80ch;
    color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 820px) {
    .exp__item,
    .edu__item {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .exp__stats {
      grid-template-columns: 1fr;
    }

    .stat {
      grid-template-columns: auto auto 1fr;
      align-items: baseline;
      column-gap: 10px;
      padding: 16px 18px;
    }

    .stat--exact {
      grid-template-columns: auto 1fr;
    }

    .stat--exact .stat__prefix {
      display: none;
    }

    .stat__value {
      font-size: 40px;
    }

    .stat__label {
      margin-top: 0;
    }
  }
</style>
