---
import { education, experience } from "../content/copy";
---

<section class="section exp" id="experience" aria-labelledby="exp-title">
  <div class="container">
    <h2 class="section-name" id="exp-title">{experience.heading}</h2>
    <p class="exp__summary">{experience.summary}</p>

    <ol class="exp__list">
      {
        experience.roles.map((role) => (
          <li class="exp__item">
            <p class="exp__dates mono">{role.dates}</p>
            <div class="exp__body">
              <h3 class="exp__role">{role.role}</h3>
              <p class="exp__org">{role.org}</p>
              <ul class="exp__points">
                {role.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="edu">
      <h3 class="edu__title">{education.heading}</h3>
      <ul class="edu__list">
        {
          education.items.map((item) => (
            <li class="edu__item">
              <p class="exp__dates mono">{item.dates}</p>
              <div>
                <p class="edu__name">{item.title}</p>
                <p class="exp__org">{item.org}</p>
                {item.note && <p class="edu__note">{item.note}</p>}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="edu__certs">{education.certifications}</p>
    </div>
  </div>
</section>

<style>
  .exp__summary {
    margin-top: 18px;
    max-width: 80ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text);
    text-wrap: balance;
  }

  .exp__list {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }

  .exp__item,
  .edu__item {
    display: grid;
    grid-template-columns: minmax(150px, 0.32fr) minmax(0, 1fr);
    gap: 24px;
    padding-block: clamp(28px, 3.6vw, 48px);
    border-bottom: 1px solid var(--line);
  }

  .exp__dates {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--muted);
    padding-top: 6px;
  }

  .exp__role {
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .exp__org {
    margin-top: 4px;
    color: var(--muted);
    font-weight: 500;
  }

  .exp__points {
    display: grid;
    gap: 10px;
    margin-top: 20px;
    max-width: 68ch;
  }

  .exp__points li {
    position: relative;
    padding-left: 22px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .exp__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(0.8em - 1px);
    width: 10px;
    height: 1px;
    background: var(--line-strong);
  }

  .edu {
    margin-top: 64px;
  }

  .edu__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .edu__list {
    margin-top: 18px;
    border-top: 1px solid var(--line);
  }

  .edu__item {
    padding-block: 24px;
  }

  .edu__name {
    font-size: 19px;
    font-weight: 650;
    line-height: 1.3;
  }

  .edu__note {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
  }

  .edu__certs {
    margin-top: 24px;
    max-width: 80ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .exp__item,
    .edu__item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
