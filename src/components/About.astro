---
import { Picture } from "astro:assets";
import headshot from "../assets/headshot.jpg";
import { about } from "../content/copy";
import { resume } from "../content/resume";
import SectionLabel from "./SectionLabel.astro";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__copy">
      <SectionLabel id="about-title" heading={about.heading} />
      <p class="lead about__lead" data-reveal>{about.lead}</p>
      <div class="prose about__body" data-reveal style="--reveal-delay: 0.08s">
        {about.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="about__links" data-reveal style="--reveal-delay: 0.14s">
        <a class="link" href={`/resume/${resume.pdfName}`} download>
          {about.resumeDownload}
          <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v9M3 6.5l4 4 4-4M2 13h10" stroke="currentColor" fill="none" stroke-width="1.3"></path></svg>
        </a>
        <a class="link" href="/resume">
          {about.resumeView}
          <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" stroke="currentColor" fill="none" stroke-width="1.3"></path></svg>
        </a>
      </div>
    </div>
    <figure class="about__photo" data-reveal style="--reveal-delay: 0.1s">
      <Picture
        src={headshot}
        alt={about.headshotAlt}
        formats={["avif", "webp"]}
        widths={[400, 600, 800, 1100]}
        sizes="(max-width: 820px) 92vw, 40vw"
        loading="lazy"
        decoding="async"
        class="about__img"
      />
    </figure>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(40px, 7vw, 112px);
    align-items: center;
  }

  .about__lead {
    margin-top: 32px;
    max-width: 24ch;
  }

  .about__body {
    margin-top: 28px;
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin-top: 36px;
  }

  .about__photo {
    position: relative;
    isolation: isolate;
  }

  /* Black and white, dissolving into the page on every edge, so the studio
     backdrop reads as part of the dark layout rather than a grey box. */
  .about__photo {
    --fade: radial-gradient(ellipse 60% 52% at 50% 38%, #000 42%, rgba(0, 0, 0, 0.6) 62%, transparent 86%);
    --top: linear-gradient(to bottom, transparent 0%, #000 18%);
  }

  .about__photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: contrast(1.12) brightness(0.86);
    -webkit-mask-image: var(--fade), var(--top);
    -webkit-mask-composite: source-in;
    mask-image: var(--fade), var(--top);
    mask-composite: intersect;
  }

  /* A faint amber wash in the shadows ties the photo to the accent. */
  .about__photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255, 176, 0, 0.1), transparent 70%);
    mix-blend-mode: screen;
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__photo {
      order: -1;
      max-width: 440px;
    }
  }
</style>
