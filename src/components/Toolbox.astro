---
import { toolbox } from "../content/copy";
---

<section class="section toolbox" id="toolbox" aria-labelledby="toolbox-title">
  <div class="container">
    <h2 class="section-name" id="toolbox-title">{toolbox.heading}</h2>
    <ul class="toolbox__list">
      {
        toolbox.groups.map((group) => (
          <li class="toolbox__row">
            <span class="toolbox__label">{group.title}</span>
            <span class="toolbox__tools">{group.tools}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .toolbox__list {
    max-width: 80ch;
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }

  .toolbox__row {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.5;
  }

  .toolbox__label {
    color: var(--text);
    font-weight: 600;
  }

  .toolbox__tools {
    color: var(--muted);
  }

  @media (max-width: 520px) {
    .toolbox__row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
