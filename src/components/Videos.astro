---
import { videos } from "../content/copy";
import { getVideo } from "../lib/media";
import VideoButton from "./VideoButton.astro";
import VideoRow from "./VideoRow.astro";
import SectionLabel from "./SectionLabel.astro";

const items = videos.items.map((item) => ({
  ...item,
  media: item.films ? null : getVideo(item.id),
  films: item.films?.map((film) => ({ ...film, media: getVideo(film.id) })) ?? null,
}));
const singles = items.filter((item) => !item.films);
const series = items.filter((item) => item.films);

// What the modal needs to play each file, keyed by media id.
const playable: Record<string, { title: string; src: string; poster: string; orientation: string }> = {};
for (const item of items) {
  if (item.media) {
    playable[item.id] = { title: item.title, src: item.media.src, poster: item.media.poster, orientation: item.media.orientation };
  }
  for (const film of item.films ?? []) {
    playable[film.id] = {
      title: `${item.title}: ${film.title}`,
      src: film.media.src,
      poster: film.media.poster,
      orientation: film.media.orientation,
    };
  }
}
---

<section class="section videos" id="videos" aria-labelledby="videos-title">
  <div class="container">
    <div class="videos__head">
      <SectionLabel id="videos-title" heading={videos.heading} />
      <p class="videos__intro">
        {videos.intro}{" "}
        <span class="videos__hint videos__hint--pointer">{videos.hint}</span>
        <span class="videos__hint videos__hint--touch">{videos.hintTouch}</span>
      </p>
    </div>

    <div class="vgrid">
      {
        singles.map((item, i) =>
          item.media ? (
            <article class="vcard" data-reveal style={`--reveal-delay: ${(i % 4) * 0.06}s`}>
              <VideoButton id={item.id} title={item.title} media={item.media} />
              <div class="vcard__info">
                <p class="vcard__num mono">0{i + 1}</p>
                <h3 class="vcard__title">{item.title}</h3>
                <p class="vcard__line">{item.line}</p>
                <p class="vcard__credit">{item.credit}</p>
              </div>
            </article>
          ) : null,
        )
      }

      {
        series.map((item) => (
          <article class="vcard vcard--series" data-reveal style={`--reveal-delay: ${(singles.length % 4) * 0.06}s`}>
            <ul class="vcard__films">
              {item.films?.map((film) => (
                <li>
                  <VideoRow id={film.id} title={`${item.title}: ${film.title}`} label={film.title} media={film.media} />
                </li>
              ))}
            </ul>
            <div class="vcard__info">
              <p class="vcard__num mono">0{singles.length + 1}</p>
              <h3 class="vcard__title">{item.title}</h3>
              <p class="vcard__line">{item.line}</p>
              <p class="vcard__credit">{item.credit}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<dialog class="vmodal" aria-labelledby="vmodal-title" data-video-modal data-lenis-prevent>
  <div class="vmodal__panel">
    <div class="vmodal__bar">
      <h2 class="vmodal__title" id="vmodal-title" data-video-title></h2>
      <button class="vmodal__close mono" type="button" data-video-close>
        {videos.close}
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.4"></path></svg>
      </button>
    </div>
    <div class="vmodal__player" data-video-frame>
      <video controls playsinline preload="none" data-video-player></video>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="video-data" set:html={JSON.stringify(playable)} />

<style>
  .videos__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: end;
  }

  .videos__intro {
    color: var(--muted);
    max-width: 46ch;
    justify-self: end;
  }

  .videos__hint--touch {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .videos__hint--pointer {
      display: none;
    }

    .videos__hint--touch {
      display: inline;
    }
  }

  /* Three cards and a four-part series sit in one row of four. Each card is
     a container, so the series playlist can match the height of a poster. */
  .vgrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 40px) clamp(16px, 2vw, 28px);
    margin-top: 48px;
  }

  .vcard {
    container-type: inline-size;
  }

  .vcard__films {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 12px;
    /* A poster is 9:16 and its bar is 42px tall. */
    height: calc(100cqw * 16 / 9 + 42px);
  }

  .vcard__films li {
    min-height: 0;
  }

  .vcard__info {
    padding-top: 18px;
  }

  .vcard__num {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .vcard__title {
    margin-top: 8px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .vcard__line {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* One short line of what I did on the film. */
  .vcard__credit {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.45;
    color: var(--text);
    text-wrap: pretty;
  }

  @media (max-width: 1024px) {
    .vgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .videos__head {
      grid-template-columns: 1fr;
    }

    .videos__intro {
      justify-self: start;
    }
  }

  /* One card to a row on phones. */
  @media (max-width: 640px) {
    .vgrid {
      grid-template-columns: 1fr;
    }

    .vcard__title {
      font-size: 18px;
    }

    .vcard__films {
      height: auto;
      grid-template-rows: none;
    }
  }

  /* Modal player */
  .vmodal {
    width: min(100vw - 32px, 1180px);
    max-width: none;
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg);
    overflow: hidden;
  }

  .vmodal[data-orientation="portrait"] {
    width: min(100vw - 32px, calc((100svh - 150px) * 9 / 16 + 2px), 520px);
  }

  .vmodal__panel {
    display: flex;
    flex-direction: column;
  }

  .vmodal__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 12px 12px 18px;
    border-bottom: 1px solid var(--line);
  }

  .vmodal__title {
    font-size: 15px;
    font-weight: 650;
    line-height: 1.3;
  }

  .vmodal__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding-inline: 14px;
    border-radius: 999px;
    font-size: 13px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    flex: none;
  }

  .vmodal__close:hover {
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
  }

  .vmodal__close svg {
    width: 12px;
    height: 12px;
  }

  .vmodal__player {
    background: #000;
  }

  .vmodal__player video {
    width: 100%;
    max-height: calc(100svh - 150px);
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .vmodal[data-orientation="portrait"] .vmodal__player video {
    aspect-ratio: 9 / 16;
  }
</style>
