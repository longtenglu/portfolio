---
import { videos } from "../content/copy";
import { getVideo } from "../lib/media";
import VideoButton from "./VideoButton.astro";
import SectionLabel from "./SectionLabel.astro";

const items = videos.items.map((item) => ({
  ...item,
  media: item.films ? null : getVideo(item.id),
  films: item.films?.map((film) => ({ ...film, media: getVideo(film.id) })) ?? null,
}));
const feature = items.find((item) => item.media?.orientation === "landscape");
const portraits = items.filter((item) => item !== feature && !item.films);
const series = items.filter((item) => item.films);
// Without a landscape feature the cards start at 01.
const numBase = feature ? 2 : 1;

// What the modal needs to play each file, keyed by media id.
const playable: Record<string, { title: string; src: string; poster: string; orientation: string; note: string }> = {};
for (const item of items) {
  if (item.media) {
    playable[item.id] = { title: item.title, src: item.media.src, poster: item.media.poster, orientation: item.media.orientation, note: "" };
  }
  for (const film of item.films ?? []) {
    playable[film.id] = {
      title: `${item.title}: ${film.title}`,
      src: film.media.src,
      poster: film.media.poster,
      orientation: film.media.orientation,
      note: "",
    };
  }
}
---

<section class="section videos" id="videos" aria-labelledby="videos-title">
  <div class="container">
    <div class="videos__head">
      <SectionLabel id="videos-title" heading={videos.heading} />
      <p class="videos__intro">
        {videos.intro}{" "}
        <span class="videos__hint videos__hint--pointer">{videos.hint}</span>
        <span class="videos__hint videos__hint--touch">{videos.hintTouch}</span>
      </p>
    </div>

    <div class="vgrid">
      {
        feature && feature.media && (
          <article class="vcard vcard--feature" data-reveal>
            <VideoButton id={feature.id} title={feature.title} media={feature.media} />
            <div class="vcard__info">
              <p class="vcard__num mono">01</p>
              <h3 class="vcard__title">{feature.title}</h3>
              <p class="vcard__line">{feature.line}</p>
              <ul class="vcard__skills" aria-label="Skills">
                {feature.skills.map((skill) => <li class="chip">{skill}</li>)}
              </ul>
            </div>
          </article>
        )
      }

      {
        portraits.map((item, i) =>
          item.media ? (
            <article class="vcard vcard--portrait" data-reveal style={`--reveal-delay: ${(i % 4) * 0.06}s`}>
              <VideoButton id={item.id} title={item.title} media={item.media} />
              <div class="vcard__info">
                <p class="vcard__num mono">0{i + numBase}</p>
                <h3 class="vcard__title">{item.title}</h3>
                <p class="vcard__line">{item.line}</p>
                <ul class="vcard__skills" aria-label="Skills">
                  {item.skills.map((skill) => <li class="chip">{skill}</li>)}
                </ul>
              </div>
            </article>
          ) : null,
        )
      }

      {
        series.map((item) => (
          <article class="vcard vcard--series" data-reveal>
            <ul class="vcard__films">
              {item.films?.map((film) => (
                <li>
                  <VideoButton id={film.id} title={`${item.title}: ${film.title}`} media={film.media} compact />
                  <p class="vcard__film mono" aria-hidden="true">{film.title}</p>
                </li>
              ))}
            </ul>
            <div class="vcard__info">
              <p class="vcard__num mono">0{portraits.length + numBase}</p>
              <h3 class="vcard__title">{item.title}</h3>
              <p class="vcard__line">{item.line}</p>
              <ul class="vcard__skills" aria-label="Skills">
                {item.skills.map((skill) => <li class="chip">{skill}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<dialog class="vmodal" aria-labelledby="vmodal-title" data-video-modal data-lenis-prevent>
  <div class="vmodal__panel">
    <div class="vmodal__bar">
      <h2 class="vmodal__title" id="vmodal-title" data-video-title></h2>
      <button class="vmodal__close mono" type="button" data-video-close>
        {videos.close}
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.4"></path></svg>
      </button>
    </div>
    <div class="vmodal__player" data-video-frame>
      <video controls playsinline preload="none" data-video-player></video>
    </div>
    <p class="vmodal__note mono" data-video-note></p>
  </div>
</dialog>

<script is:inline type="application/json" id="video-data" set:html={JSON.stringify(playable)} />

<style>
  .videos__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: end;
  }

  .videos__intro {
    color: var(--muted);
    max-width: 46ch;
    justify-self: end;
  }

  .videos__hint--touch {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .videos__hint--pointer {
      display: none;
    }

    .videos__hint--touch {
      display: inline;
    }
  }

  .vgrid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 40px) clamp(16px, 2vw, 28px);
    margin-top: 48px;
  }

  .vcard--feature {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: end;
  }

  .vcard--portrait {
    grid-column: span 3;
  }

  .vcard--series {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: end;
    padding-top: 8px;
  }

  .vcard__films {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 20px);
  }

  .vcard__info {
    padding-top: 18px;
  }

  .vcard--feature .vcard__info,
  .vcard--series .vcard__info {
    padding-top: 0;
    padding-bottom: 4px;
  }

  .vcard__num {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .vcard__title {
    margin-top: 8px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .vcard--feature .vcard__title,
  .vcard--series .vcard__title {
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 750;
  }

  .vcard__line {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .vcard__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .vcard__film {
    margin-top: 10px;
    font-size: 12px;
    color: var(--text);
    line-height: 1.4;
  }

  @media (max-width: 1024px) {
    .vcard--portrait {
      grid-column: span 6;
    }

    .vcard--series {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .videos__head {
      grid-template-columns: 1fr;
    }

    .videos__intro {
      justify-self: start;
    }

    .vcard--feature {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .vgrid {
      column-gap: 14px;
    }

    .vcard__title {
      font-size: 17px;
    }

    .vcard__line {
      font-size: 14px;
    }

    .vcard--portrait .vcard__skills {
      display: none;
    }

    .vcard__film {
      font-size: 11px;
    }
  }

  /* Modal player */
  .vmodal {
    width: min(100vw - 32px, 1180px);
    max-width: none;
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg);
    overflow: hidden;
  }

  .vmodal[data-orientation="portrait"] {
    width: min(100vw - 32px, calc((100svh - 150px) * 9 / 16 + 2px), 520px);
  }

  .vmodal__panel {
    display: flex;
    flex-direction: column;
  }

  .vmodal__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 12px 12px 18px;
    border-bottom: 1px solid var(--line);
  }

  .vmodal__title {
    font-size: 15px;
    font-weight: 650;
    line-height: 1.3;
  }

  .vmodal__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding-inline: 14px;
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    flex: none;
  }

  .vmodal__close:hover {
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
  }

  .vmodal__close svg {
    width: 12px;
    height: 12px;
  }

  .vmodal__player {
    background: #000;
  }

  .vmodal__player video {
    width: 100%;
    max-height: calc(100svh - 150px);
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .vmodal[data-orientation="portrait"] .vmodal__player video {
    aspect-ratio: 9 / 16;
  }

  .vmodal__note {
    padding: 12px 18px 14px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .vmodal__note:empty {
    display: none;
  }
</style>
