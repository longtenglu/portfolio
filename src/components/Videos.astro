---
import { videos, workflow } from "../content/copy";
import { getImage, getVideo } from "../lib/media";
import VideoButton from "./VideoButton.astro";

const items = videos.items.map((item) => ({
  ...item,
  media: item.films ? null : getVideo(item.id),
  films: item.films?.map((film) => ({ ...film, media: getVideo(film.id) })) ?? null,
}));

const steps = workflow.steps.map((step) => ({ ...step, media: getImage(step.image) }));

// What the modal needs to play each file, keyed by media id.
const playable: Record<string, { title: string; src: string; poster: string; orientation: string; note: string }> = {};
for (const item of items) {
  const note = [item.credit, item.aiLabel].filter(Boolean).join(" · ");
  if (item.media) {
    playable[item.id] = { title: item.title, src: item.media.src, poster: item.media.poster, orientation: item.media.orientation, note };
  }
  for (const film of item.films ?? []) {
    playable[film.id] = {
      title: `${item.title}: ${film.title}`,
      src: film.media.src,
      poster: film.media.poster,
      orientation: film.media.orientation,
      note,
    };
  }
}
---

<section class="section videos" id="videos" aria-labelledby="videos-title">
  <div class="container">
    <h2 class="section-name" id="videos-title">{videos.heading}</h2>
    <div class="videos__intro">
      <p>{videos.intro}</p>
      <p class="videos__credit">{videos.credit}</p>
      <p class="videos__hint">
        <span class="videos__hint--pointer">{videos.hint}</span>
        <span class="videos__hint--touch">{videos.hintTouch}</span>
      </p>
    </div>

    <ol class="films">
      {
        items.map((item) => (
          <li
            class:list={[
              "film",
              { "film--lead": item.id === "anniversary-dinner" },
              { "film--landscape": item.id === "atp-promo" },
              { "film--series": Boolean(item.films) },
            ]}
          >
            <div class:list={["film__media", { "film__media--series": Boolean(item.films) }]}>
              {item.films
                ? item.films.map((film) => (
                    <div class="film__film">
                      <VideoButton id={film.id} title={`${item.title}: ${film.title}`} media={film.media} compact />
                      <p class="film__film-title">{film.title}</p>
                    </div>
                  ))
                : item.media && <VideoButton id={item.id} title={item.title} media={item.media} />}
            </div>
            <div class="film__info">
              <h3 class="film__title">
                {item.title}
                {item.films && <span class="film__note">{videos.seriesNote}</span>}
              </h3>
              <p class="film__line">{item.line}</p>
              {item.aiLabel && <p class="film__ai">{item.aiLabel}</p>}
              <p class="film__credit">{item.credit}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="workflow">
      <h3 class="workflow__heading">{workflow.heading}</h3>
      <p class="workflow__intro">{workflow.intro}</p>
      <ol class="workflow__grid">
        {
          steps.map((step) => (
            <li class="wstep">
              <img
                class="wstep__img"
                src={step.media.src}
                width={step.media.width}
                height={step.media.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <p class="wstep__title">{step.title}</p>
              <p class="wstep__caption">{step.caption}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<dialog class="vmodal" aria-labelledby="vmodal-title" data-video-modal data-lenis-prevent tabindex="-1">
  <div class="vmodal__panel">
    <div class="vmodal__bar">
      <h2 class="vmodal__title" id="vmodal-title" data-video-title></h2>
      <button class="vmodal__close" type="button" data-video-close>
        {videos.close}
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.4"></path></svg>
      </button>
    </div>
    <div class="vmodal__player" data-video-frame>
      <video controls playsinline preload="none" data-video-player></video>
    </div>
    <p class="vmodal__note" data-video-note></p>
  </div>
</dialog>

<script is:inline type="application/json" id="video-data" set:html={JSON.stringify(playable)} />

<style>
  .videos__intro {
    margin-top: 18px;
    max-width: 60ch;
    color: var(--muted);
  }

  .videos__credit {
    margin-top: 8px;
    color: var(--text);
    font-size: 14px;
  }

  .videos__hint {
    margin-top: 12px;
    font-size: 14px;
    color: var(--dim);
  }

  .videos__hint--touch {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .videos__hint--pointer {
      display: none;
    }

    .videos__hint--touch {
      display: inline;
    }
  }

  .films {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }

  /* The media column is as wide as its media, so the text sits a normal
     gutter from the poster instead of a fixed distance across the page. */
  .film {
    --media-w: 260px;
    display: grid;
    grid-template-columns: var(--media-w) minmax(0, 1fr);
    gap: clamp(28px, 3.5vw, 48px);
    align-items: start;
    padding-block: clamp(22px, 2.8vw, 36px);
    border-bottom: 1px solid var(--line);
  }

  .film--lead {
    --media-w: 300px;
  }

  .film--landscape {
    --media-w: 430px;
  }

  .film--series {
    --media-w: clamp(360px, 40vw, 520px);
  }

  .film__media {
    width: 100%;
    max-width: var(--media-w);
  }

  .film__media--series {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 1.2vw, 16px);
    max-width: none;
  }

  .film__film-title {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.35;
    color: var(--muted);
    text-wrap: balance;
  }

  .film__info {
    max-width: 56ch;
  }

  .film__title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .film--lead .film__title {
    font-size: clamp(26px, 2.6vw, 32px);
  }

  .film__note {
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }

  .film__line {
    margin-top: 8px;
    max-width: 52ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .film__ai {
    margin-top: 12px;
    padding-left: 10px;
    border-left: 2px solid var(--line-strong);
    font-size: 13px;
    color: var(--text);
  }

  .film__credit {
    margin-top: 8px;
    font-size: 13px;
    color: var(--dim);
  }

  .workflow {
    margin-top: clamp(56px, 7vw, 96px);
  }

  .workflow__heading {
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .workflow__intro {
    margin-top: 6px;
    font-size: 15px;
    color: var(--muted);
  }

  .workflow__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 20px);
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .wstep__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
    background: #000;
  }

  .wstep__title {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 600;
  }

  .wstep__caption {
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }

  @media (max-width: 1024px) {
    .workflow__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .film {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .film__media {
      max-width: 280px;
    }

    .film--lead .film__media {
      max-width: 300px;
    }

    .film--landscape .film__media,
    .film__media--series {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .film__media {
      max-width: 240px;
    }

    /* Lead with the title on a phone, so the work is named before its poster. */
    .film__info {
      order: -1;
    }

    .film__media--series {
      max-width: 100%;
    }

    .film__title {
      font-size: 22px;
    }

    .film--lead .film__title {
      font-size: 26px;
    }

    .workflow__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Modal player */
  .vmodal {
    width: min(100vw - 32px, 1180px);
    max-width: none;
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg);
    overflow: hidden;
  }

  .vmodal[data-orientation="portrait"] {
    width: min(100vw - 32px, calc((100svh - 150px) * 9 / 16 + 2px), 520px);
  }

  .vmodal:focus {
    outline: none;
  }

  .vmodal__panel {
    display: flex;
    flex-direction: column;
  }

  .vmodal__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 12px 12px 18px;
    border-bottom: 1px solid var(--line);
  }

  .vmodal__title {
    font-size: 15px;
    font-weight: 650;
    line-height: 1.3;
  }

  .vmodal__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding-inline: 14px;
    border-radius: 999px;
    font-size: 13px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    flex: none;
  }

  .vmodal__close:hover {
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
  }

  .vmodal__close svg {
    width: 12px;
    height: 12px;
  }

  .vmodal__player {
    background: #000;
  }

  .vmodal__player video {
    width: 100%;
    max-height: calc(100svh - 150px);
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .vmodal[data-orientation="portrait"] .vmodal__player video {
    aspect-ratio: 9 / 16;
  }

  .vmodal__note {
    padding: 12px 18px 14px;
    font-size: 12px;
    color: var(--muted);
  }
</style>
