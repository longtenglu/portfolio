---
import { whatIDo } from "../content/copy";
import SectionLabel from "./SectionLabel.astro";
---

<section class="section what" id="what" aria-labelledby="what-title">
  <div class="container">
    <SectionLabel id="what-title" heading={whatIDo.heading} />
    <ol class="what__list">
      {
        whatIDo.rows.map((row, i) => (
          <li class="what__row" data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
            <span class="what__num mono">0{i + 1}</span>
            <h3 class="what__title">{row.title}</h3>
            <p class="what__text">{row.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .what__list {
    margin-top: 48px;
    border-top: 1px solid var(--line);
  }

  .what__row {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 24px;
    align-items: center;
    padding-block: clamp(26px, 3.4vw, 44px);
    border-bottom: 1px solid var(--line);
  }

  .what__row::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .what__row:hover::before {
    transform: scaleX(1);
  }

  .what__num {
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .what__title {
    font-size: clamp(30px, 4.4vw, 64px);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 0.98;
    letter-spacing: -0.01em;
    word-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.6s var(--ease), color 0.3s;
  }

  .what__row:hover .what__title {
    transform: translateX(10px);
    color: var(--accent);
  }

  .what__text {
    color: var(--muted);
    max-width: 44ch;
    justify-self: end;
    text-wrap: pretty;
  }

  @media (max-width: 820px) {
    .what__row {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 10px 14px;
    }

    .what__text {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
