---
// Hero plus strip. On motion-friendly screens the pair sits in a sticky
// stage for half a screen of extra scroll, which parts the hands and opens the
// reel between them. The reel plays one of the Selected videos; its caption
// reads that entry's title and credit.
import { hero, site, strip, videos } from "../content/copy";
import { getReel } from "../lib/media";

const reel = getReel();
const phrases = strip.split(" • ");
const film = videos.items.find((item) => item.id === hero.reel.film);
if (!film) throw new Error(`The hero reel film "${hero.reel.film}" is not in the Selected videos.`);
---

<div class="intro" id="top" data-intro>
  <div class="intro__stage">
    <section class="hero" aria-labelledby="hero-title" data-hero>
      <canvas class="hero__canvas" aria-hidden="true" data-hero-canvas></canvas>

      <div class="hero__copy container">
        <h1 id="hero-title" class="hero__title">
          <span class="hero__name">{site.name}</span>
          <span class="hero__claim">{hero.claim}</span>
        </h1>
        <p class="hero__sub">{hero.sub}</p>
      </div>

      <div class="hero__reel" data-reel>
        <button
          class="hero__reel-frame"
          type="button"
          data-reel-frame
          data-video-open={film.id}
          aria-label={`${hero.reel.action}: ${film.title}. ${film.credit}.`}
        >
          <video
            class="hero__reel-video"
            muted
            loop
            playsinline
            preload="none"
            poster={reel.poster}
            data-reel-video
            data-src={reel.src}
            aria-hidden="true"
            tabindex="-1"></video>
        </button>
      </div>
      <p class="hero__reel-caption" data-reel-caption>
        <span class="hero__reel-tag">
          {film.title}
          <span class="hero__reel-credit">{film.credit}</span>
        </span>
        <span class="hero__reel-cta" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="12" height="12"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
          {hero.reel.watch}
        </span>
      </p>

      <div class="hero__meta">
        <p>{site.location}</p>
        <button
          class="hero__watch"
          type="button"
          data-video-open={film.id}
          data-reel-rest-cta
          aria-label={`${hero.reel.rest}: ${film.title}, with sound. ${film.credit}.`}
        >
          <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
          {hero.reel.rest}
        </button>
        <p class="hero__scroll" aria-hidden="true">
          {hero.scroll}
          <svg viewBox="0 0 12 12" width="10" height="10"><path d="M6 1v9M2 6.5 6 10.5 10 6.5" stroke="currentColor" fill="none" stroke-width="1.3"></path></svg>
        </p>
      </div>
    </section>

    <div class="strip" data-strip>
      <p class="visually-hidden">{strip}</p>
      <div class="strip__track" aria-hidden="true" data-strip-track>
        {
          [0, 1].map(() => (
            <span class="strip__unit" data-strip-unit>
              {phrases.map((phrase) => (
                <>
                  <span class="strip__phrase">{phrase}</span>
                  <span class="strip__dot">•</span>
                </>
              ))}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .intro {
    position: relative;
    /* Half a screen of extra scroll drives the hero: the reel is open after
       about a quarter of a screen and the rest holds it in view. */
    height: 150vh;
    height: 150svh;
  }

  .intro__stage {
    position: sticky;
    top: 0;
    min-height: 560px;
    min-height: max(100vh, 560px);
    min-height: max(100svh, 560px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* --open is how far the reel has opened (set by intro.ts). The copy stays
     put until the reel starts to open, then steps back as it does. */
  .hero__copy {
    position: relative;
    z-index: 2;
    padding-top: clamp(100px, 14vh, 140px);
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .hero__copy {
      opacity: calc(1 - clamp(0, var(--open, 0) * 2.6, 1));
      transform: translate3d(0, calc(var(--open, 0) * -40px), 0);
    }
  }

  .hero__title {
    display: grid;
    gap: 16px;
  }

  .hero__name {
    white-space: nowrap;
    font-size: clamp(44px, 6vw, 92px);
    font-weight: 780;
    font-stretch: 104%;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  .hero__claim {
    font-size: clamp(19px, 1.75vw, 26px);
    font-weight: 560;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--text);
    max-width: 22ch;
  }

  .hero__sub {
    margin-top: 14px;
    max-width: 52ch;
    font-size: 15px;
    color: var(--muted);
  }

  /* The reel is placed and opened by the hero script, which knows where the
     fingertips are. Without the script it sits open below the copy. */
  .hero__reel {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: min(84vw, 560px);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--accent), 0 0 60px rgba(255, 176, 0, 0.18);
    background: #000;
    transform: translate3d(var(--gutter), 52vh, 0);
    will-change: transform, width, height;
  }

  /* While the reel is closed it is a sliver: it takes no clicks, and the
     script makes its button inert, so the "Watch the film" button below is
     the trigger instead. */
  .hero__reel[data-open="false"] {
    pointer-events: none;
  }

  .hero__reel-frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .hero__reel-frame:focus-visible {
    outline-offset: -4px;
  }

  .hero__reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__reel-caption {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
    line-height: 1.35;
    color: var(--muted);
    transform: translate3d(var(--gutter), calc(52vh + 47vw + 12px), 0);
    pointer-events: none;
  }

  .hero__reel-tag {
    font-weight: 600;
    color: var(--accent);
  }

  .hero__reel-credit {
    display: block;
    margin-top: 2px;
    font-weight: 400;
    color: var(--muted);
  }

  /* On a tablet the reel is too narrow for the name, the credit and the cue
     on one row. Stack them, as on phones. */
  @media (max-width: 820px) {
    .hero__reel-caption {
      flex-direction: column;
      gap: 6px;
    }
  }

  .hero__reel-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    color: var(--text);
    font-weight: 500;
  }

  .hero__meta {
    position: absolute;
    /* On the container's edges, as the header and the copy are. */
    left: max(var(--gutter), calc((100% - var(--max)) / 2));
    right: max(var(--gutter), calc((100% - var(--max)) / 2));
    bottom: 18px;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dim);
    transition: opacity 0.3s;
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
  }

  .hero__watch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    background: var(--bg);
    transition: box-shadow 0.2s, color 0.2s, opacity 0.35s;
  }

  @media (pointer: coarse) {
    .hero__watch {
      min-height: 44px;
    }
  }

  .hero__watch svg {
    color: var(--accent);
  }

  .hero__watch:hover {
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .hero__watch:focus-visible {
    outline-offset: 3px;
  }

  /* Once the reel is open it is the trigger, and this one steps back. */
  .hero__watch[inert] {
    opacity: 0;
  }

  .strip {
    position: relative;
    flex: none;
    height: 64px;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .strip__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  /* The marquee waits for the fonts (strip.ts), so it never shows fallback
     text. Without the script, or with motion reduced, it is simply there. */
  :global(.js) .strip__track {
    opacity: 0;
    transition: opacity 0.5s;
  }

  :global(.js) .strip.is-ready .strip__track {
    opacity: 1;
  }

  .strip__unit {
    display: flex;
    align-items: center;
    flex: none;
  }

  .strip__phrase {
    padding-inline: 28px;
    font-size: 17px;
    font-weight: 720;
    font-stretch: 118%;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text);
  }

  .strip__dot {
    color: var(--accent);
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .hero__copy {
      padding-top: 96px;
    }

    .hero__meta {
      bottom: 12px;
      grid-template-columns: 1fr auto;
    }

    /* With the reel open, the caption needs the room the meta row would
       take. The location is already in the hero line above. */
    .hero__reel[data-open="true"] ~ .hero__meta {
      opacity: 0;
      pointer-events: none;
    }

    .hero__scroll {
      display: none;
    }

    .hero__reel-caption {
      flex-direction: column;
      gap: 6px;
      font-size: 13px;
    }

    .strip {
      height: 52px;
    }

    .strip__phrase {
      font-size: 14px;
      padding-inline: 20px;
    }
  }

  /* Landscape phones: about 390px tall. The copy takes the left half, the
     hands and the reel the right, and the strip is slimmer, so the first
     screen shows the whole hero and nothing is drawn over the words. */
  @media (max-height: 520px) and (orientation: landscape) and (min-width: 640px) {
    .intro__stage {
      min-height: 100vh;
      min-height: 100svh;
    }

    .hero__copy {
      padding-top: 76px;
    }

    .hero__title {
      gap: 8px;
    }

    .hero__name {
      font-size: 40px;
    }

    .hero__claim {
      max-width: none;
      font-size: 19px;
    }

    .hero__sub {
      max-width: 46vw;
      margin-top: 10px;
      font-size: 14px;
      line-height: 1.5;
    }

    .hero__reel-caption {
      flex-direction: column;
      gap: 6px;
      font-size: 13px;
    }

    .hero__meta {
      bottom: 8px;
    }

    .strip {
      height: 44px;
    }

    .strip__phrase {
      font-size: 13px;
      padding-inline: 20px;
    }
  }

  /* No pinned stage when motion is reduced: the hero is a still frame with
     the reel already open, and the strip wraps instead of scrolling. */
  @media (prefers-reduced-motion: reduce) {
    .intro {
      height: auto;
    }

    .intro__stage {
      position: relative;
    }

    .strip {
      height: auto;
      padding-block: 18px;
    }

    .strip__track,
    :global(.js) .strip__track {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      transform: none !important;
      opacity: 1;
    }

    .strip__unit {
      flex: 1 1 100%;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 8px;
    }

    .strip__unit + .strip__unit {
      display: none;
    }

    .strip__unit .strip__dot:last-child {
      display: none;
    }
  }
</style>
