---
// Hero plus strip. On motion-friendly screens the pair sits in a sticky
// stage for an extra screen of scroll, which drives the hands together and
// opens the reel between them.
import { hero, site, strip } from "../content/copy";
import { getReel } from "../lib/media";

const reel = getReel();
const phrases = strip.split(" • ");
---

<div class="intro" id="top" data-intro>
  <div class="intro__stage">
    <section class="hero" aria-labelledby="hero-title" data-hero>
      <canvas class="hero__canvas" aria-hidden="true" data-hero-canvas></canvas>

      <div class="hero__copy container" data-hero-copy>
        <h1 id="hero-title" class="hero__title">
          <span class="hero__name">{site.name}</span>
          <span class="hero__role">{hero.role}</span>
          <span class="hero__claim">{hero.claim}</span>
        </h1>
        <p class="hero__available">{hero.available}</p>
      </div>

      <div class="hero__reel" data-reel>
        <button
          class="hero__reel-frame"
          type="button"
          data-reel-frame
          data-video-open="anniversary-dinner"
          aria-label={`${hero.reel.action}: ${hero.reel.title}. ${hero.reel.label}.`}
        >
          <video
            class="hero__reel-video"
            muted
            loop
            playsinline
            preload="none"
            poster={reel.poster}
            data-reel-video
            data-src={reel.src}
            aria-hidden="true"
            tabindex="-1"></video>
        </button>
      </div>
      <p class="hero__reel-caption" data-reel-caption>
        <span class="hero__reel-tag">{hero.reel.title}</span>
        <span class="hero__reel-cta" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="12" height="12"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
          {hero.reel.watch}
        </span>
      </p>

      <div class="hero__meta" data-hero-meta>
        <p>{site.location}</p>
        <button
          class="hero__watch"
          type="button"
          data-video-open="anniversary-dinner"
          data-reel-rest-cta
          aria-label={`${hero.reel.rest}: ${hero.reel.title}, with sound. ${hero.reel.label}.`}
        >
          <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
          {hero.reel.rest}
        </button>
        <p class="hero__scroll" aria-hidden="true">
          {hero.scroll}
          <svg viewBox="0 0 12 12" width="10" height="10"><path d="M6 1v9M2 6.5 6 10.5 10 6.5" stroke="currentColor" fill="none" stroke-width="1.3"></path></svg>
        </p>
      </div>
    </section>

    <div class="strip" data-strip>
      <p class="visually-hidden">{strip}</p>
      <div class="strip__track" aria-hidden="true" data-strip-track>
        {
          [0, 1].map(() => (
            <span class="strip__unit" data-strip-unit>
              {phrases.map((phrase) => (
                <>
                  <span class="strip__phrase">{phrase}</span>
                  <span class="strip__dot">•</span>
                </>
              ))}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .intro {
    position: relative;
    /* One extra screen of scroll drives the hero. */
    height: 170vh;
    height: 170svh;
  }

  .intro__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* --p is scroll progress through the stage (set by intro.ts). The copy
     stays put until the reel is open, then steps back. */
  .hero__copy {
    position: relative;
    z-index: 2;
    padding-top: clamp(92px, 12vh, 120px);
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .hero__copy {
      opacity: calc(1 - clamp(0, (var(--p, 0) - 0.3) * 5, 1));
      transform: translate3d(0, calc(var(--p, 0) * -56px), 0);
    }
  }

  .hero__title {
    display: grid;
    gap: 12px;
  }

  .hero__name {
    white-space: nowrap;
    font-size: clamp(44px, 6vw, 92px);
    font-weight: 780;
    font-stretch: 104%;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  .hero__role {
    font-size: clamp(19px, 1.5vw, 20px);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.005em;
    color: var(--text);
    max-width: 60ch;
    text-wrap: balance;
  }

  .hero__claim {
    font-size: clamp(21px, 1.8vw, 25px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--text);
    max-width: 36ch;
    text-wrap: pretty;
  }

  .hero__available {
    margin-top: 14px;
    max-width: 66ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }

  /* The reel is placed and opened by the hero script, which knows where the
     fingertips are. Without the script it sits open below the copy. */
  .hero__reel {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: min(84vw, 560px);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--accent), 0 0 60px rgba(255, 176, 0, 0.18);
    background: #000;
    transform: translate3d(var(--gutter), 52vh, 0);
    will-change: transform, width, height;
  }

  /* While the reel is closed it is a sliver: it takes no clicks, and the
     script makes its button inert, so the "Watch the film" button below is
     the trigger instead. */
  .hero__reel[data-open="false"] {
    pointer-events: none;
  }

  .hero__reel-frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .hero__reel-frame:focus-visible {
    outline-offset: -4px;
  }

  .hero__reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__reel-caption {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: var(--muted);
    transform: translate3d(var(--gutter), calc(52vh + 47vw + 12px), 0);
    pointer-events: none;
  }

  .hero__reel-tag {
    color: var(--text);
  }

  .hero__reel-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    color: var(--text);
  }

  .hero__reel-cta svg {
    color: var(--accent);
  }

  .hero__meta {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 18px;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    color: var(--dim);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
  }

  .hero__watch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 8px 15px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-size: 13px;
    color: var(--text);
    background: var(--bg);
    transition: box-shadow 0.2s, color 0.2s, opacity 0.35s;
  }

  .hero__watch svg {
    color: var(--accent);
  }

  .hero__watch:hover {
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .hero__watch:focus-visible {
    outline-offset: 3px;
  }

  /* Once the reel is open it is the trigger, and this one steps back. */
  .hero__watch[inert] {
    opacity: 0;
  }

  .strip {
    position: relative;
    flex: none;
    height: 64px;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .strip__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .strip__unit {
    display: flex;
    align-items: center;
    flex: none;
  }

  .strip__phrase {
    padding-inline: 28px;
    font-size: 17px;
    font-weight: 680;
    font-stretch: 112%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text);
  }

  .strip__dot {
    color: var(--dim);
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .hero__copy {
      padding-top: 92px;
    }

    .hero__title {
      gap: 10px;
    }

    .hero__role {
      font-size: 19px;
    }

    .hero__claim {
      font-size: 21px;
      max-width: 30ch;
    }

    .hero__available {
      font-size: 14px;
      max-width: 38ch;
    }

    .hero__meta {
      bottom: 12px;
      grid-template-columns: 1fr auto;
    }

    .hero__scroll {
      display: none;
    }

    .hero__reel-caption {
      flex-direction: column;
      gap: 6px;
      font-size: 11px;
    }

    .strip {
      height: 52px;
    }

    .strip__phrase {
      font-size: 14px;
      padding-inline: 20px;
      letter-spacing: 0.08em;
    }
  }

  /* No pinned stage when motion is reduced: the hero is a still frame with
     the reel already open, and the strip wraps instead of scrolling. */
  @media (prefers-reduced-motion: reduce) {
    .intro {
      height: auto;
    }

    .intro__stage {
      position: relative;
      height: auto;
    }

    .hero {
      min-height: 100vh;
      min-height: 100svh;
    }

    .strip {
      height: auto;
      padding-block: 18px;
    }

    .strip__track {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      transform: none !important;
    }

    .strip__unit {
      flex: 1 1 100%;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 8px;
    }

    .strip__unit + .strip__unit {
      display: none;
    }

    .strip__unit .strip__dot:last-child {
      display: none;
    }

    .strip__phrase {
      white-space: normal;
      text-align: center;
    }
  }
</style>
