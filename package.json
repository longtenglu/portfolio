{
  "name": "longtenglu-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Longteng Lu's portfolio website",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "og:image": "node scripts/og/build-og.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "astro check && tsc --noEmit -p tsconfig.scripts.json",
    "test": "astro build && node --test tests/",
    "hero:hands": "node scripts/hero/build-hands.mjs",
    "media:build": "node scripts/media/build-media.mjs",
    "media:upload": "node scripts/media/upload-blob.mjs",
    "resume:pdf": "node scripts/resume/build-pdf.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.2",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "@vercel/blob": "^2.8.2",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
